#pragma once

// Copy to secrets.h and fill in. secrets.h is gitignored.
// The board's radio is 2.4GHz only - a 5GHz-only network will never connect.
// iPhone hotspot: turn ON "Maximize Compatibility" to force 2.4GHz + WPA2.
#define WIFI_SSID     "your-2.4GHz-network"
#define WIFI_PASSWORD "your-password"

// Laptop running the backend, on the same network (ipconfig / ifconfig).
#define BACKEND_HOST  "192.168.1.100"
#define BACKEND_PORT  8000
